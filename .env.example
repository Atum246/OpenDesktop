# OpenDesktop Environment Variables
# Copy this file to ~/.opendesktop/.env and fill in your keys
# Or export them in your shell (~/.bashrc, ~/.zshrc, $PROFILE)
#
# The setup wizard auto-detects these — no manual entry needed.

# ─── AI Providers (pick one or more) ───

# OpenRouter — access 50+ models with one key ($1 free credit)
# Get key: https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI — GPT-4o, o1, DALL-E, Whisper
# Get key: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# Anthropic — Claude 3.5 Sonnet, Opus (best reasoning)
# Get key: https://console.anthropic.com/keys
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Google AI — Gemini Pro, Flash (free tier available)
# Get key: https://aistudio.google.com/apikey
# GOOGLE_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxx

# Groq — Llama, Mixtral (fastest inference, free tier)
# Get key: https://console.groq.com/keys
# GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx

# DeepSeek — Coding specialist (free tier)
# Get key: https://platform.deepseek.com/api_keys
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# Nvidia NIM — Enterprise AI
# Get key: https://build.nvidia.com/
# NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxx

# Mistral AI
# Get key: https://console.mistral.ai/api-keys
# MISTRAL_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# ─── Messaging Platforms (optional) ───

# Telegram Bot — get from @BotFather
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Discord Bot — get from Discord Developer Portal
# DISCORD_BOT_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx

# ─── Voice & Media (optional) ───

# ElevenLabs — high-quality TTS
# Get key: https://elevenlabs.io/app/settings/api-keys
# ELEVENLABS_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI Whisper — speech-to-text (uses OPENAI_API_KEY above)

# ─── Other Services (optional) ───

# Weather — OpenWeatherMap
# Get key: https://openweathermap.org/api
# WEATHER_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
